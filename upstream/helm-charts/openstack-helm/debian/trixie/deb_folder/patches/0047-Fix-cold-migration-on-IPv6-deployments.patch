 nova/templates/bin/_nova-compute-init.sh.tpl | 142 +++++++++++++++++--
 nova/templates/bin/_nova-compute.sh.tpl      |   6 +
 nova/templates/bin/_ssh-start.sh.tpl         | 105 +++++++++++++-
 3 files changed, 242 insertions(+), 11 deletions(-)

diff --git a/nova/templates/bin/_nova-compute-init.sh.tpl b/nova/templates/bin/_nova-compute-init.sh.tpl
index 5218d3707..7f24934e0 100644
--- a/nova/templates/bin/_nova-compute-init.sh.tpl
+++ b/nova/templates/bin/_nova-compute-init.sh.tpl
@@ -16,6 +16,56 @@ limitations under the License.
 
 set -ex
 
+# A subnet is only usable to select a specific address when it is not a
+# wildcard. Wildcard values mean "any address", so the legacy interface
+# based lookup must be kept for them.
+function is_wildcard_subnet {
+    case "${1}" in
+        ""|0/0|0.0.0.0/0|::/0)
+            return 0
+            ;;
+        *)
+            return 1
+            ;;
+    esac
+}
+
+# Return the first global address that belongs to the given subnet.
+# When an interface is provided the search is restricted to it first, then
+# widened to every interface, since the address of the requested subnet may
+# be hosted by a different device than the one owning the subnet route.
+# On AIO-SX the cluster-host address lives on loopback with scope host,
+# so if scope global finds nothing, retry without the scope restriction.
+function address_in_subnet {
+    local subnet="${1}"
+    local interface="${2}"
+    local ip_opt="-4"
+    local address=""
+
+    if [[ "${subnet}" == *":"* ]]; then
+        ip_opt="-6"
+    fi
+
+    if [ -n "${interface}" ]; then
+        address=$(ip ${ip_opt} -o addr show dev ${interface} to ${subnet} scope global | awk '{ print $4; exit }' | awk -F "/" '{ print $1 }')
+    fi
+
+    if [ -z "${address}" ]; then
+        address=$(ip ${ip_opt} -o addr show to ${subnet} scope global | awk '{ print $4; exit }' | awk -F "/" '{ print $1 }')
+    fi
+
+    if [ -z "${address}" ]; then
+        if [ -n "${interface}" ]; then
+            address=$(ip ${ip_opt} -o addr show dev ${interface} to ${subnet} | awk '{ print $4; exit }' | awk -F "/" '{ print $1 }')
+        fi
+        if [ -z "${address}" ]; then
+            address=$(ip ${ip_opt} -o addr show to ${subnet} | awk '{ print $4; exit }' | awk -F "/" '{ print $1 }')
+        fi
+    fi
+
+    echo "${address}"
+}
+
 {{- if and .Values.hosts_uuids (not .Values.manifests.compute_uuid_self_provisioning) }}
 # Extract Host's uuid from helm chart and save it to the compute_id file
   {{- range $host := .Values.hosts_uuids }}
@@ -33,17 +83,56 @@ mkdir -p /var/lib/nova/instances
 chown ${NOVA_USER_UID} /var/lib/nova /var/lib/nova/instances
 
 migration_interface="{{- .Values.conf.libvirt.live_migration_interface -}}"
+migration_network_cidr="{{- .Values.conf.libvirt.live_migration_network_cidr -}}"
 if [[ -z $migration_interface ]]; then
     # search for interface with default routing
     # If there is not default gateway, exit
-    migration_network_cidr="{{- .Values.conf.libvirt.live_migration_network_cidr -}}"
     if [ -z "${migration_network_cidr}" ] ; then
-        migration_network_cidr="0/0"
+        migration_interface=$(ip -4 route list 0.0.0.0/0 | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }')
+        if [ -n "${migration_interface}" ]; then
+            migration_network_cidr="0/0"
+            inet_keyword="inet "
+        else
+            migration_interface=$(ip -6 route list ::/0 | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }')
+            migration_network_cidr="::/0"
+            inet_keyword="inet6 "
+        fi
+    else
+        if [[ "${migration_network_cidr}" == *":"* ]]; then
+            migration_interface=$(ip -6 route list ${migration_network_cidr} | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }')
+            if [ -z "${migration_interface}" ] ; then
+                migration_interface=$(ip -6 -o addr show to ${migration_network_cidr} scope global | awk '{ print $2; exit }')
+            fi
+            if [ -z "${migration_interface}" ] ; then
+                migration_interface=$(ip -6 -o addr show scope global | awk '{ print $2; exit }')
+            fi
+            inet_keyword="inet6 "
+        else
+            migration_interface=$(ip -4 route list ${migration_network_cidr} | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }')
+            if [ -z "${migration_interface}" ] ; then
+                migration_interface=$(ip -4 -o addr show to ${migration_network_cidr} scope global | awk '{ print $2; exit }')
+            fi
+            if [ -z "${migration_interface}" ] ; then
+                migration_interface=$(ip -4 -o addr show scope global | awk '{ print $2; exit }')
+            fi
+            inet_keyword="inet "
+        fi
     fi
-    migration_interface=$(ip -4 route list ${migration_network_cidr} | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }') || exit 1
 fi
 
-migration_address=$(ip a s $migration_interface | grep 'inet ' | awk '{print $2}' | awk -F "/" '{print $1}' | head -1)
+migration_address=""
+
+# When an explicit CIDR is configured, pick the address that actually belongs
+# to it instead of the first address of the interface. A single NIC may host
+# several networks (e.g. mgmt and cluster-host on the same port), in which
+# case the first address can belong to the wrong network.
+if ! is_wildcard_subnet "${migration_network_cidr}" ; then
+    migration_address=$(address_in_subnet "${migration_network_cidr}" "${migration_interface}")
+fi
+
+if [ -z "${migration_address}" ] ; then
+    migration_address=$(ip a s $migration_interface | grep "${inet_keyword}" | grep 'scope global' | awk '{print $2}' | awk -F "/" '{print $1}' | head -1)
+fi
 
 if [ -z "${migration_address}" ] ; then
   echo "Var live_migration_interface is empty"
@@ -56,17 +145,54 @@ live_migration_inbound_addr = $migration_address
 EOF
 
 hypervisor_interface="{{- .Values.conf.hypervisor.host_interface -}}"
+hypervisor_network_cidr="{{- .Values.conf.hypervisor.host_network_cidr -}}"
 if [[ -z $hypervisor_interface ]]; then
     # search for interface with default routing
     # If there is not default gateway, exit
-    hypervisor_network_cidr="{{- .Values.conf.hypervisor.host_network_cidr -}}"
     if [ -z "${hypervisor_network_cidr}" ] ; then
-        hypervisor_network_cidr="0/0"
+        hypervisor_interface=$(ip -4 route list 0.0.0.0/0 | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }')
+        if [ -n "${hypervisor_interface}" ]; then
+            hypervisor_network_cidr="0/0"
+            inet_keyword="inet "
+        else
+            hypervisor_interface=$(ip -6 route list ::/0 | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }')
+            hypervisor_network_cidr="::/0"
+            inet_keyword="inet6 "
+        fi
+    else
+        if [[ "${hypervisor_network_cidr}" == *":"* ]]; then
+            hypervisor_interface=$(ip -6 route list ${hypervisor_network_cidr} | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }')
+            if [ -z "${hypervisor_interface}" ] ; then
+                hypervisor_interface=$(ip -6 -o addr show to ${hypervisor_network_cidr} scope global | awk '{ print $2; exit }')
+            fi
+            if [ -z "${hypervisor_interface}" ] ; then
+                hypervisor_interface=$(ip -6 -o addr show scope global | awk '{ print $2; exit }')
+            fi
+            inet_keyword="inet6 "
+        else
+            hypervisor_interface=$(ip -4 route list ${hypervisor_network_cidr} | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }')
+            if [ -z "${hypervisor_interface}" ] ; then
+                hypervisor_interface=$(ip -4 -o addr show to ${hypervisor_network_cidr} scope global | awk '{ print $2; exit }')
+            fi
+            if [ -z "${hypervisor_interface}" ] ; then
+                hypervisor_interface=$(ip -4 -o addr show scope global | awk '{ print $2; exit }')
+            fi
+            inet_keyword="inet "
+        fi
     fi
-    hypervisor_interface=$(ip -4 route list ${hypervisor_network_cidr} | awk -F 'dev' '{ print $2; exit }' | awk '{ print $1 }') || exit 1
 fi
 
-hypervisor_address=$(ip a s $hypervisor_interface | grep 'inet ' | awk '{print $2}' | awk -F "/" '{print $1}' | head -1)
+hypervisor_address=""
+
+# Same reasoning as for the migration address: prefer the address that
+# belongs to the configured CIDR over the first address of the interface.
+if ! is_wildcard_subnet "${hypervisor_network_cidr}" ; then
+    hypervisor_address=$(address_in_subnet "${hypervisor_network_cidr}" "${hypervisor_interface}")
+fi
+
+if [ -z "${hypervisor_address}" ] ; then
+    hypervisor_address=$(ip a s $hypervisor_interface | grep "${inet_keyword}" | grep 'scope global' | awk '{print $2}' | awk -F "/" '{print $1}' | head -1)
+fi
 
 if [ -z "${hypervisor_address}" ] ; then
   echo "Var my_ip is empty"
