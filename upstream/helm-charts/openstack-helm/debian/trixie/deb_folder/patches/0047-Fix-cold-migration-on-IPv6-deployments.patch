+{{- define "helm-toolkit.scripts.node_address" }}
+#!/usr/bin/env python3
+
+import argparse
+import ipaddress
+import json
+import os
+import subprocess
+import sys
+
+
+class SelectionError(Exception):
+    pass
+
+
+def _split_values(value):
+    values = []
+    for item in value.replace(",", " ").split():
+        if item not in values:
+            values.append(item)
+    return values
+
+
+def _parse_addresses(value, description):
+    addresses = []
+    for item in _split_values(value):
+        try:
+            address = ipaddress.ip_address(item)
+        except ValueError as exc:
+            raise SelectionError(
+                "invalid {} address {!r}: {}".format(description, item, exc)
+            )
+        if address not in addresses:
+            addresses.append(address)
+    return addresses
+
+
+def _parse_networks(value, description):
+    networks = []
+    for item in _split_values(value):
+        # Preserve the legacy OpenStack-Helm shorthand for the IPv4
+        # default route. Python's ipaddress module does not accept "0/0".
+        if item == "0/0":
+            item = "0.0.0.0/0"
+        try:
+            network = ipaddress.ip_network(item, strict=False)
+        except ValueError as exc:
+            raise SelectionError(
+                "invalid {} CIDR {!r}: {}".format(description, item, exc)
+            )
+        if network not in networks:
+            networks.append(network)
+    return networks
+
+
+def _run_ip(*arguments):
+    try:
+        output = subprocess.check_output(
+            ["ip", "-j"] + list(arguments),
+            stderr=subprocess.STDOUT,
+            text=True,
+        )
+    except (OSError, subprocess.CalledProcessError) as exc:
+        detail = getattr(exc, "output", "")
+        raise SelectionError(
+            "failed to execute ip {}: {} {}".format(
+                " ".join(arguments), exc, detail.strip()
+            ).strip()
+        )
+    try:
+        return json.loads(output)
+    except ValueError as exc:
+        raise SelectionError("invalid JSON returned by ip: {}".format(exc))
+
+
+def _local_addresses():
+    addresses = []
+    unusable_flags = ("tentative", "dadfailed", "deprecated", "temporary")
+    for link in _run_ip("address", "show"):
+        interface = link.get("ifname", "")
+        for info in link.get("addr_info", []):
+            if info.get("family") not in ("inet", "inet6"):
+                continue
+            flags = set(info.get("flags", []))
+            if (flags.intersection(unusable_flags)
+                    or any(info.get(flag) is True for flag in unusable_flags)):
+                continue
+            try:
+                address = ipaddress.ip_address(info["local"])
+            except (KeyError, ValueError):
+                continue
+            if (address.is_unspecified or address.is_multicast
+                    or address.is_loopback or address.is_link_local):
+                continue
+            addresses.append({
+                "address": address,
+                "interface": interface,
+                "scope": info.get("scope", ""),
+            })
+    return addresses
+
+
+def _route_interface(network):
+    family = "-6" if network.version == 6 else "-4"
+    routes = _run_ip(family, "route", "list", str(network))
+    for route in routes:
+        interface = route.get("dev")
+        if interface:
+            return interface
+    return ""
+
+
+def _overlaps(left, right):
+    return left.version == right.version and left.overlaps(right)
+
+
+def _format_candidates(candidates):
+    return ", ".join(
+        "{} on {} ({})".format(
+            candidate["address"],
+            candidate["interface"],
+            candidate["scope"],
+        )
+        for candidate in candidates
+    ) or "none"
+
+
+def _find_local(addresses, address, interface=""):
+    return [
+        candidate for candidate in addresses
+        if candidate["address"] == address
+        and (not interface or candidate["interface"] == interface)
+    ]
+
+
+def _select_explicit(purpose, value, interface, local_addresses):
+    try:
+        address = ipaddress.ip_address(value)
+    except ValueError as exc:
+        raise SelectionError(
+            "{} explicit address {!r} is invalid: {}".format(
+                purpose, value, exc
+            )
+        )
+
+    if address.is_unspecified:
+        return address
+
+    candidates = _find_local(local_addresses, address, interface)
+    if not candidates:
+        suffix = " on interface {}".format(interface) if interface else ""
+        raise SelectionError(
+            "{} explicit address {} is not assigned locally{}".format(
+                purpose, address, suffix
+            )
+        )
+    return address
+
+
+def _select_legacy(purpose, network, interface, local_addresses):
+    selected_interface = interface or _route_interface(network)
+    candidates = [
+        candidate for candidate in local_addresses
+        if candidate["address"].version == network.version
+        and candidate["scope"] == "global"
+        and (not selected_interface
+             or candidate["interface"] == selected_interface)
+    ]
+    if not candidates:
+        suffix = " on interface {}".format(selected_interface) \
+            if selected_interface else ""
+        raise SelectionError(
+            "{} legacy wildcard selection found no global IPv{} address{}".format(
+                purpose, network.version, suffix
+            )
+        )
+    return candidates[0]["address"]
+
+
+def _select_without_network(purpose, interface, local_addresses):
+    if interface:
+        candidates = [
+            candidate for candidate in local_addresses
+            if candidate["interface"] == interface
+            and candidate["scope"] == "global"
+        ]
+        if len(candidates) != 1:
+            raise SelectionError(
+                "{} requires exactly one global address on interface {}; "
+                "found {} ({})".format(
+                    purpose,
+                    interface,
+                    len(candidates),
+                    _format_candidates(candidates),
+                )
+            )
+        return candidates[0]["address"]
+
+    for network in (
+            ipaddress.ip_network("0.0.0.0/0"),
+            ipaddress.ip_network("::/0")):
+        route_interface = _route_interface(network)
+        if not route_interface:
+            continue
+        try:
+            return _select_legacy(
+                purpose, network, route_interface, local_addresses
+            )
+        except SelectionError:
+            continue
+    raise SelectionError(
+        "{} could not find an address through an IPv4 or IPv6 default route".format(
+            purpose
+        )
+    )
+
+
+def _select_interface_fallback(args, requested_network, local_addresses):
+    address = _select_without_network(
+        args.purpose, args.interface, local_addresses
+    )
+    platform_networks = _parse_networks(
+        args.node_network_cidrs, "platform Node network"
+    )
+    # A unique address in a protected network can still be a floating IP.
+    for network in [requested_network] + platform_networks:
+        if address.version == network.version and address in network:
+            raise SelectionError(
+                "{} refusing interface fallback to {} in {}; "
+                "a matching local Node address is required".format(
+                    args.purpose, address, network
+                )
+            )
+    if address.version != requested_network.version:
+        raise SelectionError(
+            "{} interface {} address {} does not match requested IPv{}; "
+            "configure a matching network CIDR".format(
+                args.purpose, args.interface, address,
+                requested_network.version,
+            )
+        )
+    return address
+
+
+def select_address(args):
+    local_addresses = _local_addresses()
+
+    if args.explicit_address:
+        return _select_explicit(
+            args.purpose,
+            args.explicit_address,
+            args.interface,
+            local_addresses,
+        )
+
+    network_value = args.network_cidr
+    if not network_value:
+        return _select_without_network(
+            args.purpose, args.interface, local_addresses
+        )
+
+    requested_networks = _parse_networks(
+        network_value, "requested {}".format(args.purpose)
+    )
+    if len(requested_networks) != 1:
+        raise SelectionError(
+            "{} requires exactly one requested CIDR".format(args.purpose)
+        )
+    requested_network = requested_networks[0]
+
+    if requested_network.prefixlen == 0:
+        return _select_legacy(
+            args.purpose,
+            requested_network,
+            args.interface,
+            local_addresses,
+        )
+
+    node_address_list_value = os.environ.get("CLUSTER_HOST_IPS", "")
+    legacy_address_value = os.environ.get("CLUSTER_HOST_IP", "")
+    node_address_list = _parse_addresses(
+        node_address_list_value, "Node hostIPs"
+    )
+    legacy_addresses = _parse_addresses(legacy_address_value, "Node hostIP")
+    if node_address_list:
+        if (legacy_addresses
+                and legacy_addresses[0] != node_address_list[0]):
+            raise SelectionError(
+                "Node hostIP {} does not match the first hostIPs address {}".format(
+                    legacy_addresses[0], node_address_list[0]
+                )
+            )
+        node_addresses = node_address_list
+    else:
+        node_addresses = legacy_addresses
+    node_candidates = [
+        address for address in node_addresses
+        if address.version == requested_network.version
+        and address in requested_network
+    ]
+
+    if len(node_candidates) > 1:
+        raise SelectionError(
+            "{} has multiple Node addresses in {}: {}".format(
+                args.purpose,
+                requested_network,
+                ", ".join(str(address) for address in node_candidates),
+            )
+        )
+
+    if node_candidates:
+        node_address = node_candidates[0]
+        local_matches = _find_local(
+            local_addresses, node_address, args.interface
+        )
+        if not local_matches:
+            if args.interface:
+                return _select_interface_fallback(
+                    args, requested_network, local_addresses
+                )
+            suffix = " on interface {}".format(args.interface) \
+                if args.interface else ""
+            raise SelectionError(
+                "{} Node address {} for {} is not assigned locally{}".format(
+                    args.purpose, node_address, requested_network, suffix
+                )
+            )
+        return node_address
+
+    platform_networks = _parse_networks(
+        args.node_network_cidrs, "platform Node network"
+    )
+    if any(_overlaps(requested_network, network)
+           for network in platform_networks):
+        if args.interface:
+            return _select_interface_fallback(
+                args, requested_network, local_addresses
+            )
+        raise SelectionError(
+            "{} has no matching Node address for platform network {}; "
+            "refusing a local floating-address fallback".format(
+                args.purpose, requested_network
+            )
+        )
+
+    local_candidates = [
+        candidate for candidate in local_addresses
+        if candidate["address"].version == requested_network.version
+        and candidate["address"] in requested_network
+        and (not args.interface
+             or candidate["interface"] == args.interface)
+    ]
+    if len(local_candidates) != 1:
+        raise SelectionError(
+            "{} requires exactly one local address in {}; found {} ({})".format(
+                args.purpose,
+                requested_network,
+                len(local_candidates),
+                _format_candidates(local_candidates),
+            )
+        )
+    return local_candidates[0]["address"]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--purpose", required=True)
+    parser.add_argument("--network-cidr", default="")
+    parser.add_argument("--interface", default="")
+    parser.add_argument("--explicit-address", default="")
+    parser.add_argument("--node-network-cidrs", default="")
+    args = parser.parse_args()
+
+    try:
+        address = select_address(args)
+    except SelectionError as exc:
+        print("Address selection failed: {}".format(exc), file=sys.stderr)
+        return 1
+
+    print(address)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
+{{- end }}
