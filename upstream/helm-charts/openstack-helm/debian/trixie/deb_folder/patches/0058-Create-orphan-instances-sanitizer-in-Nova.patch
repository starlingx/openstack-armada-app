new file mode 100644
index 000000000..a26af6663
--- /dev/null
+++ b/nova/templates/cron-job-instances-sanitizer.yaml
@@ -0,0 +1,91 @@
+{{/*
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+   http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/}}
+
+{{- if .Values.manifests.cron_job_instances_sanitizer }}
+{{- $envAll := . }}
+
+{{- $serviceAccountName := "nova-instances-sanitizer" }}
+{{ tuple $envAll "instances_sanitizer" $serviceAccountName | include "helm-toolkit.snippets.kubernetes_pod_rbac_serviceaccount" }}
+---
+apiVersion: batch/v1
+kind: CronJob
+metadata:
+  name: nova-instances-sanitizer
+  annotations:
+    {{ tuple $envAll | include "helm-toolkit.snippets.release_uuid" }}
+spec:
+  ttlSecondsAfterFinished: 120
+  schedule: {{ .Values.jobs.instances_sanitizer.cron | quote }}
+  successfulJobsHistoryLimit: {{ .Values.jobs.instances_sanitizer.history.success }}
+  failedJobsHistoryLimit: {{ .Values.jobs.instances_sanitizer.history.failed }}
+  {{- if .Values.jobs.instances_sanitizer.starting_deadline }}
+  startingDeadlineSeconds: {{ .Values.jobs.instances_sanitizer.starting_deadline }}
+  {{- end }}
+  concurrencyPolicy: Forbid
+  jobTemplate:
+    metadata:
+      labels:
+{{ tuple $envAll "nova" "instances-sanitizer" | include "helm-toolkit.snippets.kubernetes_metadata_labels" | indent 8 }}
+    spec:
+      template:
+        metadata:
+          labels:
+            app.starlingx.io/component: {{ ternary "application" "platform" .Values.labels.isApplication }}
+{{ tuple $envAll "nova" "instances-sanitizer" | include "helm-toolkit.snippets.kubernetes_metadata_labels" | indent 12 }}
+          annotations:
+            configchecksum: {{ toYaml .Values.labels.isApplication | sha256sum | trunc 63 }}
+        spec:
+          serviceAccountName: {{ $serviceAccountName }}
+{{ dict "envAll" $envAll "application" "instances_sanitizer" | include "helm-toolkit.snippets.kubernetes_pod_security_context" | indent 10 }}
+{{ dict "envAll" $envAll "application" "instances_sanitizer" | include "helm-toolkit.snippets.kubernetes_pod_priority_class" | indent 10 }}
+{{ dict "envAll" $envAll "application" "instances_sanitizer" | include "helm-toolkit.snippets.kubernetes_pod_runtime_class" | indent 10 }}
+          restartPolicy: OnFailure
+          nodeSelector:
+            {{ .Values.labels.agent.compute.node_selector_key }}: {{ .Values.labels.agent.compute.node_selector_value }}
+{{ if $envAll.Values.pod.tolerations.nova.enabled }}
+{{ tuple $envAll "nova" | include "helm-toolkit.snippets.kubernetes_tolerations" | indent 10 }}
+{{ end }}
+          initContainers:
+{{ tuple $envAll "instances_sanitizer" list | include "helm-toolkit.snippets.kubernetes_entrypoint_init_container" | indent 12 }}
+          containers:
+            - name: nova-orphan-instances-sanitizer
+{{ tuple $envAll "nova_sanitizer" | include "helm-toolkit.snippets.image" | indent 14 }}
+{{ tuple $envAll $envAll.Values.pod.resources.sanitizer | include "helm-toolkit.snippets.kubernetes_resources" | indent 14 }}
+{{ dict "envAll" $envAll "application" "nova" "container" "nova_sanitizer" | include "helm-toolkit.snippets.kubernetes_container_security_context" | indent 14 }}
+              env:
+{{- with $env := dict "ksUserSecret" $envAll.Values.secrets.identity.nova "useCA" (or .Values.manifests.certificates .Values.tls.identity) }}
+{{- include "helm-toolkit.snippets.keystone_openrc_env_vars" $env | indent 14 }}
+{{- end }}
+              command:
+                - /tmp/orphan-instances-sanitizer.sh
+              volumeMounts:
+                - name: pod-tmp
+                  mountPath: /tmp
+                - name: nova-bin
+                  mountPath: /tmp/orphan-instances-sanitizer.sh
+                  subPath: orphan-instances-sanitizer.sh
+                  readOnly: true
+                - name: run
+                  mountPath: /run
+          volumes:
+            - name: pod-tmp
+              emptyDir: {}
+            - name: nova-bin
+              configMap:
+                name: nova-bin
+                defaultMode: 0555
+            - name: run
+              hostPath:
+                path: /run
+{{- end }}
\ No newline at end of file
