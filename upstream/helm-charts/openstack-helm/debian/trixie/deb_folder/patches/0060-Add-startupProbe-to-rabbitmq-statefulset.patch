From 468f7d162406d1890f94ba3e0154df4d25979198 Mon Sep 17 00:00:00 2001
From: Amit Mahajan <Amit.Mahajan@windriver.com>
Date: Fri, 31 Jul 2026 09:26:34 -0400
Subject: [PATCH] Add startupProbe to rabbitmq statefulset

On deployments using network-attached storage, RabbitMQ boot can
take longer than the liveness probe timeout, causing pod restarts
before startup completes.

Add a startupProbe using rabbitmq-diagnostics check_running.
While active, Kubernetes suspends liveness and readiness probes,
allowing slow boot to complete without triggering restarts. Once
the node is fully booted, the startup probe passes and
liveness/readiness resume for fast failure detection.

Change-Id: Ica4d721a29a4c4effdff50c0b0e28cd93eaa543f
Signed-off-by: Amit Mahajan <Amit.Mahajan@windriver.com>
---
 rabbitmq/templates/statefulset.yaml | 7 +++++++
 rabbitmq/values.yaml                | 7 +++++++
 2 files changed, 14 insertions(+)

diff --git a/rabbitmq/templates/statefulset.yaml b/rabbitmq/templates/statefulset.yaml
index 60d1081f2..d879aeed0 100644
--- a/rabbitmq/templates/statefulset.yaml
+++ b/rabbitmq/templates/statefulset.yaml
@@ -28,6 +28,12 @@ exec:
   command:
     - /tmp/rabbitmq-liveness.sh
 {{- end }}
+{{- define "rabbitmqStartupProbeTemplate" }}
+exec:
+  command:
+    - rabbitmq-diagnostics
+    - check_running
+{{- end }}
 
 {{/*
 (aostapenko) rounds cpu limit in any permissible format to integer value (min 1)
@@ -276,6 +282,7 @@ spec:
 {{- end }}
 {{ dict "envAll" $envAll "component" "rabbitmq" "container" "rabbitmq" "type" "readiness" "probeTemplate" (include "rabbitmqReadinessProbeTemplate" $envAll | fromYaml) | include "helm-toolkit.snippets.kubernetes_probe" | trim | indent 10 }}
 {{ dict "envAll" $envAll "component" "rabbitmq" "container" "rabbitmq" "type" "liveness" "probeTemplate" (include "rabbitmqLivenessProbeTemplate" $envAll | fromYaml) | include "helm-toolkit.snippets.kubernetes_probe" | trim | indent 10 }}
+{{ dict "envAll" $envAll "component" "rabbitmq" "container" "rabbitmq" "type" "startup" "probeTemplate" (include "rabbitmqStartupProbeTemplate" $envAll | fromYaml) | include "helm-toolkit.snippets.kubernetes_probe" | trim | indent 10 }}
           lifecycle:
             preStop:
               exec:
diff --git a/rabbitmq/values.yaml b/rabbitmq/values.yaml
index d8de538fd..4b81a085d 100644
--- a/rabbitmq/values.yaml
+++ b/rabbitmq/values.yaml
@@ -69,6 +69,13 @@ pod:
             timeoutSeconds: 10
             successThreshold: 1
             failureThreshold: 5
+        startup:
+          enabled: true
+          params:
+            initialDelaySeconds: 10
+            periodSeconds: 10
+            timeoutSeconds: 5
+            failureThreshold: 30
   security_context:
     server:
       pod:
-- 
2.43.0

