             if grastate_raw:
                 break
@@ -582,20 +652,20 @@ def set_grastate_val(key, value):
     value -- the value to set the key to
     """
     logger.debug("Updating grastate.dat key={0} value={1}".format(key, value))
-    with open("/var/lib/mysql/grastate.dat", "r") as sources:
+    with open(GRASTATE_PATH, "r") as sources:
         lines = sources.readlines()
         for line_num, line_content in enumerate(lines):
             if line_content.startswith("{0}:".format(key)):
                 line_content = "{0}: {1}\n".format(key, value)
             lines[line_num] = line_content
-    with open("/var/lib/mysql/grastate.dat", "w") as sources:
+    with open(GRASTATE_PATH, "w") as sources:
         for line in lines:
             sources.write(line)
 
 
 def update_grastate_configmap():
     """Update state configmap with grastate.dat info."""
-    while not os.path.exists('/var/lib/mysql/grastate.dat'):
+    while not os.path.exists(GRASTATE_PATH):
         time.sleep(1)
     logger.info("Updating grastate configmap")
     grastate = dict()
@@ -610,44 +680,74 @@ def update_grastate_configmap():
             set_configmap_data(key=configmap_key, value=grastate_value)
 
 
+def recover_wsrep_position():
+    """Run a recovery pass over the data directory and return the position.
+
+    mariadbd is started with the wsrep provider enabled, which is what lets
+    this replay a tc.log that registered the wsrep engine. A successful
+    replay also resolves the in-doubt transactions and removes tc.log, so
+    callers can use this to make the data directory safe for a subsequent
+    --wsrep-on=false start.
+
+    Returns the recovered position, or None if the pass completed without
+    printing one. Callers that need the position must check for None
+    themselves; callers that only need the replay should verify the
+    postcondition they care about instead, because the position is scraped
+    from mariadbd's log text and is a weaker signal than the state on disk.
+    """
+    wsrep_recover = subprocess.Popen(  # nosec
+        [
+            MYSQL_BINARY_NAME, '--bind-address=127.0.0.1',
+            '--wsrep_cluster_address=gcomm://', '--wsrep-recover'
+        ],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        encoding="utf-8")
+    try:
+        out, err = wsrep_recover.communicate(timeout=MYSQL_RECOVERY_TIMEOUT)
+    except subprocess.TimeoutExpired:
+        wsrep_recover.kill()
+        out, err = wsrep_recover.communicate()
+        logger.error(
+            "The wsrep recovery pass did not finish within {0}s and was "
+            "killed. How long a replay takes depends on how much in-doubt "
+            "work was outstanding, so a busy database may need "
+            "conf.galera.mysql_recovery_timeout raised, along with the "
+            "startupProbe budget.".format(MYSQL_RECOVERY_TIMEOUT))
+    wsrep_rec_pos = None
+    # NOTE: communicate() returns a tuple (stdout_data, stderr_data).
+    # The data will be strings if streams were opened in text mode;
+    # otherwise, bytes. If it is bytes, we should decode and get a
+    # str for the err.split() to not error below.
+    if isinstance(err, bytes):
+        err = err.decode('utf-8')
+    for item in err.split("\n"):
+        logger.info("Recovering wsrep position: {0}".format(item))
+        if "WSREP: Recovered position:" in item:
+            line = item.strip().split()
+            wsrep_rec_pos = line[-1].split(':')[-1]
+    if wsrep_recover.returncode != 0:
+        logger.error(
+            "The wsrep recovery pass exited {0}".format(
+                wsrep_recover.returncode))
+    return wsrep_rec_pos
+
+
 def update_grastate_on_restart():
     """Update the grastate.dat on node restart."""
     logger.info("Updating grastate info for node")
-    if os.path.exists('/var/lib/mysql/grastate.dat'):
+    if os.path.exists(GRASTATE_PATH):
         if get_grastate_val(key='seqno') == '-1':
             logger.info(
                 "Node shutdown was not clean, getting position via wsrep-recover"
             )
 
