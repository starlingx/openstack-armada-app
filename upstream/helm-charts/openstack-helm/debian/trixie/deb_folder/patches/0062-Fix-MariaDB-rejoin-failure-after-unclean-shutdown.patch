diff --git a/mariadb/values.yaml b/mariadb/values.yaml
index 099b25415..ce68ec619 100644
--- a/mariadb/values.yaml
+++ b/mariadb/values.yaml
@@ -362,6 +362,17 @@ conf:
       failover_user_class: mariadb_failover
   galera:
     cluster_leader_ttl: 60
+    # Startup budget for a node whose previous shutdown was unclean. The
+    # tc.log replay runs first, bounded by mysql_recovery_timeout, and the
+    # wait for the local server follows it, bounded by
+    # mysql_status_max_retries * mysql_status_retry_delay. The two are
+    # consecutive, so their sum must stay inside the startupProbe deadline
+    # (pod.probes.server.mariadb.startup). With these defaults that is
+    # 300 + 10 * 30 = 600s against a 660s deadline, so raise the probe too
+    # if you raise these for slower storage or a busier database.
+    mysql_recovery_timeout: 300
+    mysql_status_max_retries: 10
+    mysql_status_retry_delay: 30
   database:
     mysql_histfile: "/dev/null"
     my: |
