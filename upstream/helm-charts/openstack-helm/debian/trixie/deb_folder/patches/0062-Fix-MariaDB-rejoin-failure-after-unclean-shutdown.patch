         else:
             logger.info("Node shutdown was clean, using grastate.dat")
 
@@ -881,7 +981,7 @@ def run_mysqld(cluster='existing'):
     if cluster == 'new':
         mysqld_cmd.append('--wsrep-new-cluster')
 
-    mysql_data_dir = '/var/lib/mysql'
+    mysql_data_dir = MYSQL_DATA_DIR
     db_test_dir = "{0}/mysql".format(mysql_data_dir)
     if os.path.isdir(db_test_dir):
         logger.info("Setting the admin passwords to the current value and upgrade mysql if needed")
@@ -910,12 +1010,38 @@ def run_mysqld(cluster='existing'):
         with open(bootstrap_sql_file, 'w') as f:
             f.write(template)
             f.close()
-        run_cmd_with_logging_thread = threading.Thread(target=run_cmd_with_logging, args=([
-            MYSQL_BINARY_NAME, '--bind-address=127.0.0.1', '--wsrep-on=false',
-            "--init-file={0}".format(bootstrap_sql_file)
-        ], logger))
-        run_cmd_with_logging_thread.start()
-        wait_mysql_status()
+        if os.path.exists(TC_LOG_PATH):
+            # The local mariadbd started below runs with --wsrep-on=false, so
+            # it cannot replay a tc.log that registered the wsrep engine:
+            # recovery aborts with "You must enable all engines that were
+            # enabled at the moment of the crash" and mariadbd exits.
+            #
+            # Replay it here instead, with wsrep enabled, which resolves the
+            # in-doubt transactions and removes the log. Recovering rather
+            # than deleting means no XA state is discarded, so this is safe on
+            # the bootstrap path too, where this node's data may be the only
+            # copy.
+            logger.warning(
+                "{0} is present, so the previous shutdown was not clean. "
+                "Replaying it with wsrep enabled before starting the local "
+                "mariadbd.".format(TC_LOG_PATH))
+            recover_wsrep_position()
+            # Check the state on disk rather than trusting the recovered
+            # position, which is scraped from mariadbd's log text. A pass
+            # that failed but still printed a position line would otherwise
+            # send us into the wsrep-disabled start with the log intact,
+            # which aborts on every restart and never clears itself.
+            if os.path.exists(TC_LOG_PATH):
+                raise Exception(
+                    "{0} is still present after the recovery pass, refusing "
+                    "to start the local mariadbd".format(TC_LOG_PATH))
+        if not launch_local_mysqld(bootstrap_sql_file):
+            # Fail instead of waiting forever. Exiting lets the container be
+            # restarted, which is recoverable and visible, whereas blocking
+            # here leaves the pod Running and never Ready with no operator
+            # signal beyond the logs.
+            raise Exception(
+                'Local mariadbd did not become available, cannot proceed')
         logger.info("Upgrading local mysql instance")
         upgrade_cmd=['mariadb-upgrade', '--skip-write-binlog',
                      "--user={0}".format(mysql_dbadmin_username),
