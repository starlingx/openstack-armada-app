 mariadb/templates/statefulset.yaml  |   6 +
 mariadb/values.yaml                 |  11 ++
 3 files changed, 195 insertions(+), 52 deletions(-)

diff --git a/mariadb/templates/bin/_start.py.tpl b/mariadb/templates/bin/_start.py.tpl
index f25e29348..98c61e6b3 100644
--- a/mariadb/templates/bin/_start.py.tpl
+++ b/mariadb/templates/bin/_start.py.tpl
@@ -143,6 +143,28 @@ default_sleep = 20
 # set one name for all commands, avoid "magic names"
 MYSQL_BINARY_NAME='mariadbd'
 
+MYSQL_DATA_DIR = '/var/lib/mysql'
+GRASTATE_PATH = os.path.join(MYSQL_DATA_DIR, 'grastate.dat')
+
+# Transaction coordinator log. MariaDB creates it when more than one
+# XA-capable storage engine is enabled and removes it on clean shutdown.
+# Its presence at startup therefore means the previous shutdown was not
+# clean and crash recovery still has to replay it.
+TC_LOG_PATH = os.path.join(MYSQL_DATA_DIR, 'tc.log')
+
+# Startup budget. The recovery pass runs first and the status wait follows
+# it, so the two are consecutive rather than concurrent and their sum has
+# to stay inside the startupProbe deadline. With the defaults below that
+# worst case is 300 + 10 x 30 = 600s against a 660s deadline. Stretching
+# either of these means stretching the probe too, see the note in
+# values.yaml. os.getenv is read with "or" rather than a default argument
+# because the statefulset always sets these, so the case to defend against
+# is an empty value rather than an absent one, and int('') would otherwise
+# raise before the logger exists.
+MYSQL_RECOVERY_TIMEOUT = int(os.getenv('MYSQL_RECOVERY_TIMEOUT') or 300)
+MYSQL_STATUS_MAX_RETRIES = int(os.getenv('MYSQL_STATUS_MAX_RETRIES') or 10)
+MYSQL_STATUS_RETRY_DELAY = int(os.getenv('MYSQL_STATUS_RETRY_DELAY') or 30)
+
 
 def ensure_state_configmap(pod_namespace, configmap_name, configmap_body):
     """Ensure the state configmap exists.
@@ -190,12 +212,26 @@ def run_cmd_with_logging(popenargs,
     return child.wait()
 
 
-def wait_mysql_status(delay=30):
+def wait_mysql_status(delay=MYSQL_STATUS_RETRY_DELAY,
+                      retries=MYSQL_STATUS_MAX_RETRIES,
+                      server_thread=None):
+    """Wait for the local mariadbd instance to accept connections.
+
+    Keyword arguments:
+    delay -- seconds to wait between attempts
+    retries -- maximum number of attempts before giving up
+    server_thread -- thread running the mariadbd instance being waited on.
+                     If that thread has exited, mariadbd is gone and there
+                     is nothing left to wait for, so return immediately.
+
+    Returns True if mariadbd became available, False otherwise. This must
+    not block forever: the caller has to be able to react to a mariadbd
+    that died during startup instead of leaving the pod Running but never
+    Ready.
+    """
     logger.info("Start checking mariadb status")
-    i = 0
-    res = 1
-    while True:
-        logger.info("Checking mysql status {0}".format(i))
+    for i in range(retries):
+        logger.info("Checking mysql status {0}/{1}".format(i + 1, retries))
         cmd = ['mariadb',
             "--defaults-file=/etc/mysql/admin_user.cnf",
             "--host=localhost"]
@@ -205,17 +241,51 @@ def wait_mysql_status(delay=30):
         res = run_cmd_with_logging(cmd, logger)
         if res == 0:
             logger.info("mariadb status check passed")
-            break
-        else:
-            logger.info("mariadb status check failed")
-        i += 1
+            return True
+        logger.info("mariadb status check failed")
+        if server_thread is not None and not server_thread.is_alive():
+            logger.error(
+                "The mariadbd instance being waited on has already exited, "
+                "abandoning the status check")
+            return False
         time.sleep(delay)
+    logger.error(
+        "mariadb did not become available after {0} attempts".format(retries))
+    return False
+
+
+def launch_local_mysqld(bootstrap_sql_file):
+    """Start a local, non-replicating mariadbd and wait for it to be usable.
+
+    Used to apply the admin account changes and run the schema upgrade
+    before the replicating instance is started. Replication is disabled so
+    those statements are not sent to the cluster.
+
+    Keyword arguments:
+    bootstrap_sql_file -- SQL file passed to mariadbd via --init-file
+
+    Returns True if mariadbd became available, False otherwise.
+    """
+    server_thread = threading.Thread(
+        target=run_cmd_with_logging,
+        args=([
+            MYSQL_BINARY_NAME, '--bind-address=127.0.0.1', '--wsrep-on=false',
+            "--init-file={0}".format(bootstrap_sql_file)
+        ], logger))
+    # Daemon, so that when the caller gives up and raises, the interpreter
+    # can exit instead of blocking forever joining a thread that is still
+    # waiting on a mariadbd which never became usable. Without this the
+    # container stays Running and never Ready, which is the state this
+    # bound exists to avoid.
+    server_thread.daemon = True
+    server_thread.start()
+    return wait_mysql_status(server_thread=server_thread)
 
 
 def stop_mysqld():
     """Stop mysqld, assuming pid file in default location."""
     logger.info("Shutting down any mysqld instance if required")
-    mysqld_pidfile_path = "/var/lib/mysql/{0}.pid".format(local_hostname)
+    mysqld_pidfile_path = os.path.join(MYSQL_DATA_DIR, "{0}.pid").format(local_hostname)
 
     def is_pid_running(pid):
