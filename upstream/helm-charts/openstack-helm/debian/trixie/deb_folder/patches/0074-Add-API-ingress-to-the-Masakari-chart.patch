From fb80c0e4cb303d47583d833a29ff6f2c7357fa2d Mon Sep 17 00:00:00 2001
From: Sridhar Kumar Ettkepalli <SridharKumar.Ettkepalli@windriver.com>
Date: Tue, 3 Nov 2026 17:05:32 -0500
Subject: [PATCH] Add API ingress to the Masakari chart

The Masakari chart ships no ingress, so the public instance-ha
endpoint registered in Keystone has nothing behind it and the API is
only reachable in-cluster.

Add ingress-api, service-ingress-api and secret-ingress-tls built on
the helm-toolkit manifests, the same way the other OpenStack charts
expose their public endpoints. The public short host becomes
"masakari" so the ingress Service does not collide with the
masakari-api Service.

Signed-off-by: Sridhar Kumar Ettkepalli <SridharKumar.Ettkepalli@windriver.com>
---
 masakari/templates/ingress-api.yaml         | 18 ++++++++++++++++++
 masakari/templates/secret-ingress-tls.yaml  | 17 +++++++++++++++++
 masakari/templates/service-ingress-api.yaml | 18 ++++++++++++++++++
 masakari/values.yaml                        | 16 +++++++++++++++-
 4 files changed, 68 insertions(+), 1 deletion(-)
 create mode 100644 masakari/templates/ingress-api.yaml
 create mode 100644 masakari/templates/secret-ingress-tls.yaml
 create mode 100644 masakari/templates/service-ingress-api.yaml

diff --git a/masakari/templates/ingress-api.yaml b/masakari/templates/ingress-api.yaml
new file mode 100644
index 000000000..7e3cb7ee6
--- /dev/null
+++ b/masakari/templates/ingress-api.yaml
@@ -0,0 +1,18 @@
+{{/*
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+   http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/}}
+
+{{- if and .Values.manifests.ingress_api .Values.network.masakari_api.ingress.public }}
+{{- $ingressOpts := dict "envAll" . "backendService" "masakari_api" "backendServiceType" "instance_ha" "backendPort" "n-api" -}}
+{{ $ingressOpts | include "helm-toolkit.manifests.ingress" }}
+{{- end }}
diff --git a/masakari/templates/secret-ingress-tls.yaml b/masakari/templates/secret-ingress-tls.yaml
new file mode 100644
index 000000000..eaca1dae7
--- /dev/null
+++ b/masakari/templates/secret-ingress-tls.yaml
@@ -0,0 +1,17 @@
+{{/*
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+   http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/}}
+
+{{- if .Values.manifests.secret_ingress_tls }}
+{{- include "helm-toolkit.manifests.secret_ingress_tls" ( dict "envAll" . "backendService" "masakari_api" "backendServiceType" "instance_ha" ) }}
+{{- end }}
diff --git a/masakari/templates/service-ingress-api.yaml b/masakari/templates/service-ingress-api.yaml
new file mode 100644
index 000000000..ad4b152b6
--- /dev/null
+++ b/masakari/templates/service-ingress-api.yaml
@@ -0,0 +1,18 @@
+{{/*
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+   http://www.apache.org/licenses/LICENSE-2.0
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/}}
+
+{{- if and .Values.manifests.service_ingress_api .Values.network.masakari_api.ingress.public }}
+{{- $serviceIngressOpts := dict "envAll" . "backendServiceType" "instance_ha" -}}
+{{ $serviceIngressOpts | include "helm-toolkit.manifests.service_ingress" }}
+{{- end }}
diff --git a/masakari/values.yaml b/masakari/values.yaml
index 17f502886..1087df54d 100644
--- a/masakari/values.yaml
+++ b/masakari/values.yaml
@@ -81,7 +81,7 @@ endpoints:
     name: masakari
     hosts:
       default: masakari-api
-      public: masakari-api
+      public: masakari
     host_fqdn_override:
       default: null
     path:
@@ -244,6 +244,10 @@ secrets:
     masakari: masakari-rabbitmq-user
   oci_image_registry:
     masakari: masakari-oci-image-registry
+  tls:
+    instance_ha:
+      masakari_api:
+        public: masakari-tls-public
 
 dependencies:
   static:
@@ -623,6 +627,13 @@ conf:
 
 network:
   masakari_api:
+    ingress:
+      public: true
+      classes:
+        namespace: "nginx"
+        cluster: "nginx-cluster"
+      annotations:
+        nginx.ingress.kubernetes.io/rewrite-target: /
     node_port:
       enabled: false
       port: 33033
@@ -645,6 +656,9 @@ manifests:
   secret_registry: true
   job_rabbit_init: true
   service_api: true
+  ingress_api: true
+  service_ingress_api: true
+  secret_ingress_tls: true
   pdb_api: true
   # Host Monitors in containers needs pacemaker remote.
   host_monitor: false
-- 
2.34.1

