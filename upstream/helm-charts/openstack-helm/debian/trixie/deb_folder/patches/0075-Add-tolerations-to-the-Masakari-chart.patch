diff --git a/masakari/templates/job-ks-user.yaml b/masakari/templates/job-ks-user.yaml
index 93a029e5c..8fd69ca4e 100644
--- a/masakari/templates/job-ks-user.yaml
+++ b/masakari/templates/job-ks-user.yaml
@@ -20,5 +20,8 @@ helm.sh/hook-weight: "-1"
 {{- if .Values.manifests.job_ks_user }}
 {{- $ksUserJob := dict "envAll" . "serviceName" "masakari" -}}
 {{- $_ := set $ksUserJob "jobAnnotations" (include "metadata.annotations.job.ks_user" . | fromYaml ) }}
+{{- if .Values.pod.tolerations.masakari.enabled -}}
+{{- $_ := set $ksUserJob "tolerationsEnabled" true -}}
+{{- end -}}
 {{ $ksUserJob | include "helm-toolkit.manifests.job_ks_user" }}
 {{- end }}
diff --git a/masakari/templates/job-rabbitmq-init.yaml b/masakari/templates/job-rabbitmq-init.yaml
index 32adb57ba..e6c39e955 100644
--- a/masakari/templates/job-rabbitmq-init.yaml
+++ b/masakari/templates/job-rabbitmq-init.yaml
@@ -20,5 +20,8 @@ helm.sh/hook-weight: "-4"
 {{- if .Values.manifests.job_rabbit_init }}
 {{- $rmqUserJob := dict "envAll" . "serviceName" "masakari" -}}
 {{- $_ := set $rmqUserJob "jobAnnotations" (include "metadata.annotations.job.rabbit_init" . | fromYaml) }}
+{{- if .Values.pod.tolerations.masakari.enabled -}}
+{{- $_ := set $rmqUserJob "tolerationsEnabled" true -}}
+{{- end -}}
 {{ $rmqUserJob | include "helm-toolkit.manifests.job_rabbit_init" }}
 {{- end }}
diff --git a/masakari/values.yaml b/masakari/values.yaml
index 17f502886..6f95b5d0e 100644
--- a/masakari/values.yaml
+++ b/masakari/values.yaml
@@ -291,6 +291,16 @@ dependencies:
           service: identity
 
 pod:
+  tolerations:
+    masakari:
+      enabled: false
+      tolerations:
+        - key: node-role.kubernetes.io/master
+          operator: Exists
+          effect: NoSchedule
+        - key: node-role.kubernetes.io/control-plane
+          operator: Exists
+          effect: NoSchedule
   security_context:
     masakari:
       pod:
-- 
