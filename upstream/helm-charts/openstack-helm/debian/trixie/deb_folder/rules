#!/usr/bin/make -f
export DH_VERBOSE = 1

export ROOT = debian/tmp
export HELM_FOLDER = $(ROOT)/usr/lib/helm
# Chart version for this release. Bump once per release to match the target
# version
export CHART_VERSION = 2026.1.1

%:
	dh $@

override_dh_auto_build:
	# Substitute image tag tokens in chart values
	find . -name "values.yaml" -exec sed -i \
	    -e 's|@IMAGE_PREFIX@|$(IMAGE_PREFIX)|g' \
	    -e 's|@IMAGE_SUFFIX@|$(IMAGE_SUFFIX)|g' \
	    -e 's|@BUILD_STREAM@|$(BUILD_STREAM)|g' \
	    -e 's|@OS@|$(OS)|g' \
	    -e 's|@OS_CODENAME@|$(OS_CODENAME)|g' \
	    -e 's|@OS_ARCH@|$(OS_ARCH)|g' \
	    -e 's|@PLATFORM_REGISTRY@|$(PLATFORM_REGISTRY)|g' \
	    {} +
	# Create the chart TGZ files.
	make SKIP_CHANGELOG=1 helm-toolkit
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) gnocchi
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) libvirt
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) mariadb
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) memcached
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) openvswitch
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) rabbitmq
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) ceph-rgw
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) prometheus-openstack-exporter
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) aodh
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) barbican
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) ceilometer
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) cinder
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) glance
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) heat
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) horizon
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) ironic
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) keystone
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) neutron
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) nova
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) placement
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) watcher
	make SKIP_CHANGELOG=1 BASE_VERSION=$(CHART_VERSION) masakari

override_dh_auto_install:
	# Install the chart tar files.
	install -d -m 755 $(HELM_FOLDER)
	install -p -D -m 755 *.tgz $(HELM_FOLDER)

override_dh_auto_test:

override_dh_usrlocal:
