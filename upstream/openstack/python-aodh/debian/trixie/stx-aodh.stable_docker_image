BUILDER=loci
LABEL=stx-aodh
PROJECT=infra
PROJECT_REPO=nil
DIST_REPOS="OS +openstack"
# Empty on purpose: a pip venv at /var/lib/openstack shadows Debian's pinned
# cryptography 3.3.2 and breaks pyOpenSSL 20.0.1 (Ceph nautilus pins).
# aodhclient and pymemcache come from DIST_PACKAGES instead.
PIP_PACKAGES=""
PROFILES="apache"
# aodh-common ships the /usr/bin/aodh-* scripts, including the aodh-api WSGI
# script. The aodh-api package is skipped; the chart runs the API under mod_wsgi.
DIST_PACKAGES="\
  aodh-common \
  python3-aodh \
  python3-aodhclient \
  python3-pymemcache \
"
# Reinstall aodh-common after loci's cleanup.sh: purging patch cascades
# through dpkg-dev and removes aodh-common.
CUSTOMIZATION="\
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends aodh-common && \
    rm -rf /var/lib/apt/lists/* && \
    ln -s /etc/apache2/mods-available/wsgi.load /etc/apache2/mods-enabled/wsgi.load && \
    ln -s /etc/apache2/mods-available/wsgi.conf /etc/apache2/mods-enabled/wsgi.conf
"
