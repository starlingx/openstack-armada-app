+    def _parse_cinder_catalog_info(self):
+        """Return (service_type, service_name, interface)."""
+        return self.store_conf.cinder_catalog_info.split(':', 2)
+
+    def _cinderclient_catalog_kwargs(self):
+        """Return cinderclient catalog kwargs from cinder_catalog_info."""
+        service_type, service_name, interface = (
+            self._parse_cinder_catalog_info())
+        kwargs = {
+            'service_type': service_type or 'block-storage',
+            'endpoint_type': interface or 'publicURL',
+        }
+        if service_name:
+            kwargs['service_name'] = service_name
+        return kwargs
+
+    def _cinder_endpoint_from_template(self, context):
+        """Resolve cinder_endpoint_template to an explicit Cinder URL."""
+        template = self.store_conf.cinder_endpoint_template
+        try:
+            if context is not None:
+                return template % context.to_dict()
+            return template % {}
+        except (KeyError, TypeError, ValueError) as err:
+            LOG.warning(_LW("Unable to format cinder_endpoint_template "
+                            "(%(err)s); falling back to catalog lookup."),
+                        {'err': err})
+            return None
+
+    def _cinder_url_from_context_catalog(self, context):
+        """Look up the Cinder URL from the request context service catalog."""
+        service_type, service_name, interface = (
+            self._parse_cinder_catalog_info())
+        try:
+            catalog = keystone_sc.ServiceCatalogV2(context.service_catalog)
+            return catalog.url_for(
+                region_name=self.store_conf.cinder_os_region_name,
+                service_type=service_type,
+                service_name=service_name,
+                interface=interface)
+        except keystone_exc.EndpointNotFound:
+            reason = _("Failed to find Cinder from a service catalog.")
+            raise exceptions.BadStoreConfiguration(store_name="cinder",
+                                                   reason=reason)
+
     def get_cinderclient(self, context=None, version='3.0'):
         user_overriden = self.is_user_overriden()
         session = get_cinder_session(self.store_conf)
+        extra = self._cinderclient_catalog_kwargs()
 
         if user_overriden:
             username = self.store_conf.cinder_store_user_name
             url = self.store_conf.cinder_store_auth_address
             # use auth that is already in the session
             auth = None
+            if self.store_conf.cinder_endpoint_template:
+                template_url = self._cinder_endpoint_from_template(context)
+                if template_url:
+                    url = template_url
+                    extra['os_endpoint'] = url
         else:
             username = context.user_id
             project = context.project_id
@@ -749,23 +804,10 @@
             token = context.auth_token or '%s:%s' % (username, project)
 
             if self.store_conf.cinder_endpoint_template:
-                template = self.store_conf.cinder_endpoint_template
-                url = template % context.to_dict()
+                url = (self._cinder_endpoint_from_template(context) or
+                       self._cinder_url_from_context_catalog(context))
             else:
-                info = self.store_conf.cinder_catalog_info
-                service_type, service_name, interface = info.split(':')
-                try:
-                    catalog = keystone_sc.ServiceCatalogV2(
-                        context.service_catalog)
-                    url = catalog.url_for(
-                        region_name=self.store_conf.cinder_os_region_name,
-                        service_type=service_type,
-                        service_name=service_name,
-                        interface=interface)
-                except keystone_exc.EndpointNotFound:
-                    reason = _("Failed to find Cinder from a service catalog.")
-                    raise exceptions.BadStoreConfiguration(store_name="cinder",
-                                                           reason=reason)
+                url = self._cinder_url_from_context_catalog(context)
             auth = ksa_token_endpoint.Token(endpoint=url, token=token)
 
         api_version = api_versions.APIVersion(version)
@@ -773,7 +815,8 @@
             session=session, auth=auth,
             region_name=self.store_conf.cinder_os_region_name,
             retries=self.store_conf.cinder_http_retries,
-            api_version=api_version)
+            api_version=api_version,
+            **extra)
 
         LOG.debug(
             'Cinderclient connection created for user %(user)s using URL: '
