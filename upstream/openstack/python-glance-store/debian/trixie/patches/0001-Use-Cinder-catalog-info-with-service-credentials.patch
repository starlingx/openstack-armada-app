+        self.assertEqual('internalURL', cc.client.interface)
+        self.assertEqual('block-storage', cc.client.service_type)
+        self.assertIsNone(cc.client.service_name)
+        self.assertIsNone(cc.client.endpoint_override)
+
+    def _test_get_cinderclient_user_overriden_endpoint_template(
+            self, group='glance_store'):
+        fake_endpoint = (
+            'http://cinder.internal.example.com/v3/fake_project')
+        cc = self._get_cinderclient_with_user_overriden(
+            group=group,
+            **{'cinder_endpoint_template': fake_endpoint})
+        self.assertEqual(fake_endpoint, cc.client.endpoint_override)
+        self.assertEqual('publicURL', cc.client.interface)
+        self.assertEqual('block-storage', cc.client.service_type)
+
+    def _test_get_cinderclient_user_overriden_template_overrides_catalog(
+            self, group='glance_store'):
+        fake_endpoint = (
+            'http://cinder.internal.example.com/v3/fake_project')
+        cc = self._get_cinderclient_with_user_overriden(
+            group=group,
+            **{'cinder_catalog_info': 'block-storage::internalURL',
+               'cinder_endpoint_template': fake_endpoint})
+        self.assertEqual(fake_endpoint, cc.client.endpoint_override)
+        # Catalog kwargs are always passed; template only overrides the URL.
+        self.assertEqual('internalURL', cc.client.interface)
+
+    def _test_get_cinderclient_user_overriden_unformattable_template(
+            self, group='glance_store'):
+        self.context.to_dict.return_value = {}
+        cc = self._get_cinderclient_with_user_overriden(
+            group=group,
+            **{'cinder_catalog_info': 'block-storage::internalURL',
+               'cinder_endpoint_template':
+                   'http://cinder.example.com/v3/%(project_id)s'})
+        self.assertIsNone(cc.client.endpoint_override)
+        self.assertEqual('internalURL', cc.client.interface)
+
+    def _test_get_cinderclient_app_cred_catalog_info(
+            self, group='glance_store'):
+        cinder._reset_cinder_session()
+        with mock.patch.object(cinder.ksa_session, 'Session'), \
+            mock.patch.object(
+                cinder.ksa_identity, 'V3ApplicationCredential'):
+            cc = self._get_cinderclient_with_application_credential(
+                group=group,
+                **{'cinder_catalog_info': 'block-storage::internalURL'})
+            self.assertEqual('internalURL', cc.client.interface)
+            self.assertEqual('block-storage', cc.client.service_type)
+            self.assertIsNone(cc.client.endpoint_override)
 
