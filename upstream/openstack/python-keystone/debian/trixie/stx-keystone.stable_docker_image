BUILDER=loci
LABEL=stx-keystone
PROJECT=keystone
PROJECT_REPO=https://opendev.org/openstack/keystone.git
PROJECT_REF=b3512f0b7bf91989e0159f5a18391a81174e344c
PIP_PACKAGES="\
  ldap \
  ldappool \
  python-ldap
"
DIST_PACKAGES="libapache2-mod-auth-openidc libaprutil1t64 libaprutil1-ldap libaprutil1-dbd-sqlite3"
DIST_REPOS="OS +openstack"
PROFILES="fluent apache"
CUSTOMIZATION="\
    ln -s /etc/apache2/mods-available/wsgi.load /etc/apache2/mods-enabled/wsgi.load && \
    ln -s /etc/apache2/mods-available/wsgi.conf /etc/apache2/mods-enabled/wsgi.conf && \
    a2enmod auth_openidc || true && \
    sed -i \"s/getattr(base64, 'decodebytes', base64.decodestring)/getattr(base64, 'decodebytes')/g\" /var/lib/openstack/lib/python3.13/site-packages/saml2/saml.py && \
    sed -i \"s/getattr(base64, 'encodebytes', base64.encodestring)/getattr(base64, 'encodebytes')/g\" /var/lib/openstack/lib/python3.13/site-packages/saml2/saml.py
"
