+class TestRestoreRecoveredHosts(testtools.TestCase):
+
+    @mock.patch.object(config, 'load_incluster_config')
+    @mock.patch.object(client, 'CoreV1Api')
+    def setUp(self, mock_core_v1_api, mock_load_incluster_config):
+        super(TestRestoreRecoveredHosts, self).setUp()
+        self.CONF = self.useFixture(fixture_config.Config()).conf
+        self.CONF.set_override('restore_recovered_hosts', True, 'kubernetes')
+        self.host_monitor = manager.KubernetesCheck()
+        self.host_monitor.hostname = "node00"
+        self.host_monitor.monitoring_samples = 2
+        self.host_monitor.last_status = {"node01": True}
+        self.host_monitor.restore_pending = {"node01"}
+        self.host_monitor.monitoring_data = {
+            "node01": deque(['True', 'True'], maxlen=2)}
+
+    def _node(self, name):
+        return V1Node(metadata=V1ObjectMeta(name=name),
+                      status=V1NodeStatus(conditions=[
+                          V1NodeCondition(status="True", type="Ready")]))
+
+    @mock.patch.object(masakari.SendNotification,
+                       'clear_recovered_maintenance', return_value={"node01"})
+    def test_restores_ready_host(self, mock_clear):
+        self.host_monitor.poll_hosts()
+        mock_clear.assert_called_once_with(["node01"])
+        self.assertEqual(set(), self.host_monitor.restore_pending)
+
+    @mock.patch.object(masakari.SendNotification,
+                       'clear_recovered_maintenance', return_value=set())
+    def test_keeps_host_pending_when_restore_must_retry(self, mock_clear):
+        self.host_monitor.poll_hosts()
+        mock_clear.assert_called_once_with(["node01"])
+        self.assertEqual({"node01"}, self.host_monitor.restore_pending)
+
+    @mock.patch.object(masakari.SendNotification,
+                       'clear_recovered_maintenance')
+    def test_waits_for_full_ready_window(self, mock_clear):
+        self.host_monitor.monitoring_data = {
+            "node01": deque(['True', 'Unknown'], maxlen=2)}
+        self.host_monitor.poll_hosts()
+        mock_clear.assert_not_called()
+
+    @mock.patch.object(masakari.SendNotification,
+                       'clear_recovered_maintenance')
+    def test_skips_host_not_pending(self, mock_clear):
+        self.host_monitor.restore_pending = set()
+        self.host_monitor.poll_hosts()
+        mock_clear.assert_not_called()
+
+    @mock.patch.object(masakari.SendNotification,
+                       'clear_recovered_maintenance')
+    def test_turned_off(self, mock_clear):
+        self.CONF.set_override('restore_recovered_hosts', False, 'kubernetes')
+        self.host_monitor.poll_hosts()
+        mock_clear.assert_not_called()
+
+    @mock.patch.object(masakari.SendNotification,
+                       'clear_recovered_maintenance', return_value={"node01"})
+    def test_never_restores_itself(self, mock_clear):
+        self.host_monitor.hostname = "node01"
+        self.host_monitor.poll_hosts()
+        mock_clear.assert_not_called()
+
+    @mock.patch.object(masakari.SendNotification, 'send_notification')
+    @mock.patch.object(masakari.SendNotification,
+                       'clear_recovered_maintenance', return_value={"node01"})
+    def test_down_host_is_restored_after_it_returns(self, mock_clear,
+                                                    mock_send):
+        self.host_monitor.restore_pending = set()
+        self.host_monitor.monitoring_data = {
+            "node01": deque(['Unknown', 'Unknown'], maxlen=2)}
+        self.host_monitor.poll_hosts()
+        self.assertEqual({"node01"}, self.host_monitor.restore_pending)
+        mock_clear.assert_not_called()
+
+        self.host_monitor.monitoring_data = {
+            "node01": deque(['True', 'True'], maxlen=2)}
+        self.host_monitor.poll_hosts()
+        mock_clear.assert_called_once_with(["node01"])
+        self.assertEqual(set(), self.host_monitor.restore_pending)
+
+    def test_first_update_marks_every_node_pending(self):
+        nodes = V1NodeList(items=[self._node("node01"), self._node("node02")])
+        with mock.patch.object(self.host_monitor.kube_client, 'list_node',
+                               return_value=nodes):
+            self.host_monitor.restore_pending = None
+            self.host_monitor.update_monitoring_data()
+        self.assertEqual({"node01", "node02"},
+                         self.host_monitor.restore_pending)
+
+    def test_update_prunes_removed_nodes_from_pending(self):
+        self.host_monitor.restore_pending = {"node01", "node02"}
+        nodes = V1NodeList(items=[self._node("node01")])
+        with mock.patch.object(self.host_monitor.kube_client, 'list_node',
+                               return_value=nodes):
+            self.host_monitor.update_monitoring_data()
+        self.assertEqual({"node01"}, self.host_monitor.restore_pending)
